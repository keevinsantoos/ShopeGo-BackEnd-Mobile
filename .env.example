# Servidor
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Banco em memória para testar localmente sem precisar da Service Account do Firebase
USE_IN_MEMORY_DB=false

# Firebase Admin SDK
# Opção 1: Caminho para o arquivo JSON da Service Account
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Opção 2: Variáveis individuais (alternativa ao arquivo JSON)
# FIREBASE_PROJECT_ID=seu-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@seu-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gateway de Pagamento: "mock" (padrão local) ou "mercadopago"
PAYMENT_PROVIDER=mock

# Mercado Pago (obrigatório quando PAYMENT_PROVIDER=mercadopago)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3333
